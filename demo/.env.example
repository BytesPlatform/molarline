# Copy to .env.local for local work, or paste these into the Vercel or Render
# dashboard for a deploy. Nothing here is secret until you fill it in; once you
# do, never commit the filled file. .env is gitignored.

# Postgres connection string. OPTIONAL. Leave it unset and the demo runs on
# PGlite, an embedded Postgres that needs no account, no Docker and no network.
# Set it only when the demo data has to survive a restart (Neon, Supabase,
# Render Postgres). Same SQL either way.
DATABASE_URL=

# Where PGlite keeps its files when DATABASE_URL is unset. Defaults to ./.pgdata.
# On Render use /tmp/pgdata, because the rest of the filesystem is read only on
# some instance types.
PGLITE_DIR=./.pgdata

# SECRET. Retell dashboard, API Keys. Two jobs: the push script authenticates
# with it, and the webhook routes verify the x-retell-signature HMAC with it.
# The key here must be the same key that created the agent, or every webhook
# will be rejected as an invalid signature.
RETELL_API_KEY=

# Public key for the browser call widget, Retell dashboard, same page as the
# API key. Safe to ship to the browser. Needed only for in-browser calls.
NEXT_PUBLIC_RETELL_PUBLIC_KEY=

# The agent id. Printed by: npx tsx retell/push-demo-config.ts
NEXT_PUBLIC_RETELL_AGENT_ID=

# The Retell phone number bound to the agent, in E.164, for example
# +15551234567. Shown on the demo page so the room can dial it.
NEXT_PUBLIC_DEMO_PHONE_NUMBER=

# SECRET. Salt for the one way patient and phone pseudonyms written to the
# audit log, so the log carries no direct identifier. Change it from the
# default before any deploy. Generate one with: openssl rand -hex 32
PATIENT_HASH_SALT=

# Accept unsigned webhooks. Keep it false or unset for a real demo, so the
# signature check runs and the compliance panel shows it passing. Set it to
# true only to drive tests/demo-pipeline.http by hand without a voice call.
ALLOW_UNSIGNED_WEBHOOKS=false

# ---------------------------------------------------------------------------
# Sign-in and tenancy (phase 0). The public demo at / needs none of these.
# ---------------------------------------------------------------------------

# Clerk, one application per product. Create it at https://dashboard.clerk.com,
# then under User & Authentication > Restrictions set sign-up mode to
# Restricted so accounts only come from invitations. Both keys blank means
# /app and /admin are closed and the public demo still works.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# SECRET.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Our own team, comma separated. These addresses can open /admin, create
# customers, send invitations and open any workspace. Everyone else who signs
# in only sees the workspace they were invited to.
PLATFORM_ADMIN_EMAILS=

# Development only, ignored in production and ignored when Clerk keys exist:
# treat every request as this signed-in email, so /app and /admin can be
# worked on before the Clerk application is created. Add the same address to
# PLATFORM_ADMIN_EMAILS to reach the admin console.
AUTH_DEV_USER=

# ---------------------------------------------------------------------------
# Landing site, email and jobs (phase 1).
# ---------------------------------------------------------------------------

# The public address of this deployment, used in emails and canonical links.
NEXT_PUBLIC_SITE_URL=https://molarline.vercel.app

# Where demo requests are sent. Defaults to bytesuite@bytesplatform.com.
SALES_INBOX=bytesuite@bytesplatform.com

# SECRET. SendGrid API key with Mail Send permission. Blank keeps every email
# as a preview row in the admin console and sends nothing.
SENDGRID_API_KEY=
# A sender verified in SendGrid (Settings > Sender Authentication). Required
# to send; SendGrid rejects mail from an unverified address.
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=MolarLine
# The verification key from SendGrid's Event Webhook settings, so delivery,
# open, click and bounce events can update the messages table. Blank refuses
# every event post.
SENDGRID_WEBHOOK_PUBLIC_KEY=
# SendGrid allows two event webhooks per account, so one webhook serves all
# three products. On the site that receives it, list the other sites here and
# events are forwarded to them with their signature intact.
SENDGRID_EVENT_FANOUT=

# SECRET. Vercel Cron sends "Authorization: Bearer <this>" to /api/jobs/run
# every five minutes (see vercel.json; needs the Pro plan, Hobby allows daily
# only). The console also has a "Run due jobs now" button. Generate: openssl rand -hex 32.
# Blank means the worker refuses to run and follow-up emails stay queued.
CRON_SECRET=
